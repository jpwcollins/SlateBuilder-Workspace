    {
      "name": "pro-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "apps/slatebuilder-pro",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
