{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "offices",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:offices"
      ],
      "port": 3000
    },
    {
      "name": "pro",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:pro"
      ],
      "port": 3000
    },
    {
